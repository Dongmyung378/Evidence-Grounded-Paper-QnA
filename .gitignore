# Local source data; redistribute only after checking each paper's license.
data/raw/qasper/
data/raw/papers/*.pdf
data/processed/reranker_pairs_*.jsonl

# Generated model/index artifacts.
data/processed/*.npy
data/processed/*.npz

# Python cache.
__pycache__/
*.py[cod]
.pytest_cache/

# Local task and document-review scratch directories.
.tmp_*/

# Local environment overrides and secrets. Commit only the example file.
.env
.env.*
!.env.example

# Private implementation journal. Keep day-by-day notes off GitHub.
local_notes/

# Private uploaded PDFs, per-paper artifacts, and local job metadata.
data/runtime/

# Local benchmark runs; only deliberately reviewed results are versioned.
data/quality_benchmark/*.local.json
outputs/

# Private writing and scratch output. Published benchmark evidence is allowlisted.
private_notes/
personal_notes/
work_logs/
*.log
data/quality_benchmark/runs/*
!data/quality_benchmark/runs/2026-10-10/
data/quality_benchmark/runs/2026-10-10/*
