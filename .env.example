# Host ports
PAPER_QNA_API_PORT=8000
PAPER_QNA_UI_PORT=8501

# Application runtime
PAPER_QNA_SEED=378
PAPER_QNA_MAX_PENDING_JOBS=16
PAPER_QNA_PREPARE_MODELS=true
PAPER_QNA_MODEL_LOCAL_FILES_ONLY=false
PAPER_QNA_LOG_LEVEL=info

# Optional Hugging Face token for higher download limits. Never commit a real token.
# HF_TOKEN=hf_example
